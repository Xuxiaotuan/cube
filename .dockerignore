# Caches
packages/cubejs-backend-native/target
packages/*/node_modules/
packages/*/dist/
packages/*/coverage/
# Other
packages/cubejs-server-core/playground/
!rust/cubestore/
!rust/cubestore/tsconfig.json
rust/cubestore/target/
